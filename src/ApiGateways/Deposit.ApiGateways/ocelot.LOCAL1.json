{
    "Routes": [
        {
            "DownstreamPathTemplate": "/api/{everything}",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [
                {
                    "Host": "licensee_deposit_api_LOCAL_1",
                    "Port": 5000
                }
            ],
            "UpstreamPathTemplate": "/api/deposit/{everything}",
            "UpstreamHttpMethod": [
                "POST",
                "PUT"
            ],
            "SwaggerKey": "Deposit"
        },
        {
            "DownstreamPathTemplate": "/main/licensees/{everything}",
            "DownstreamScheme": "https",
            "DownstreamHostAndPorts": [
                {
                    "Host": "las.nexdev.net",
                    "Port": 443
                }
            ],
            "UpstreamPathTemplate": "/api/licensees/{everything}",
            "UpstreamHttpMethod": [
                "POST",
                "PUT"
            ],
            "SwaggerKey": "AdminSetting"
        }
    ],
    "GlobalConfiguration": {
        "BaseUrl": "https://dep-api-gw.nexdev.net/v1"
    },
    "SwaggerEndPoints": [
        {
            "Key": "Deposit",
            "TransformByOcelotConfig": false,
            "Config": [
                {
                    "Name": "Deposit API",
                    "Version": "v1",
                    "Url": "https://deposit-api1.nexdev.net/swagger/v1/swagger.json"
                }
            ]
        },
        {
            "Key": "AdminSetting",
            "TransformByOcelotConfig": false,
            "Config": [
                {
                    "Name": "Licensee Admin Setting API",
                    "Version": "v1",
                    "Url": "https://las.nexdev.net/main/swagger/v1/swagger.json"
                }
            ]
        }
    ]
}