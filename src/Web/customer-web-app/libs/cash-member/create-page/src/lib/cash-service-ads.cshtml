@{
    var cdnUri = ViewBag.CdnUri ?? "";
}

<style>
    @keyframes fadeInBg {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @keyframes fadeInPopup {
        from { transform: scale(0.95); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }

    @keyframes pulse {
        0% { transform: scale(0.95); }
        50% { transform: scale(1.1); }
        100% { transform: scale(0.95); }
    }

    .pulseAnimate {
        animation: pulse 1.2s infinite;
        display: inline-block;
    }

    .overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.2);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
        animation: fadeInBg 0.3s;
    }

    .popup {
        position: absolute;
        max-width: 620px;
        height: auto;
        margin: 20px;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 8px 32px rgba(0,0,0,0.18);
        animation: fadeInPopup 0.35s;
        background: #b4d2e8;
    }

    .closeButton {
        position: absolute;
        top: 16px;
        right: 16px;
        background: rgba(255, 255, 255, 0.2);
        border: none;
        border-radius: 50%;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 1;
        color: white;
        font-size: 20px;
        font-weight: bold;
        transition: background 0.2s;
    }

    .bannerImage {
        width: 100%;
        height: auto;
        object-fit: cover;
    }

    .activeCashContent {
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 20px 32px;
        background: linear-gradient(90deg,rgba(182, 218, 236, 0.56) 40%, rgba(180, 210, 232, 0) 60%);
        box-sizing: border-box;
    }

    .contentBox {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #0a2c4d;
        padding: 12px 16px;
        background: white;
        border-radius: 16px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        max-width: 480px;
        margin: 0 auto;
    }

    .title {
        font-weight: 600;
        font-size: 18px;
        color: #0a2c4d;
        text-align: center;
        margin-bottom: 14px;
    }

    .divider {
        width: 60px;
        height: 2px;
        background: #0a2c4d;
        margin: 0 auto 20px auto;
        border-radius: 2px;
    }

    .description {
        font-size: 14px;
        color: #222;
        text-align: center;
        margin-bottom: 5px;
        font-weight: 400;
        max-width: 400px;
    }

    .buttonContainer {
        display: flex;
        gap: 8px;
        justify-content: center;
        width: 100%;
        margin-top: 20px;
    }

    .primaryButton {
        background: #0a2c4d;
        color: rgb(255, 255, 255);
        border: none;
        min-width: 90px;
        border-radius: 18px;
        padding: 10px 18px;
        font-weight: 500;
        font-size: 13px;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
        transition: background 0.2s;
        letter-spacing: 0.2px;
    }

    .secondaryButton {
        color: #ffffff;
        background: #286fa1;
        border: none;
        min-width: 90px;
        border-radius: 18px;
        padding: 10px 18px;
        font-weight: 500;
        font-size: 13px;
        cursor: pointer;
        transition: background 0.2s;
        letter-spacing: 0.2px;
    }

    .adsContent {
        position: absolute;
        top: 0;
        left: 0;
        width: 50%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: linear-gradient(90deg,rgba(182, 218, 236, 0.56) 40%, rgba(180, 210, 232, 0) 60%);
        box-sizing: border-box;
    }

    .mainTitle {
        font-weight: 800;
        font-size: 38px;
        color: #03548d;
        line-height: 1.2;
        text-align: center;
        max-width: 350px;
        letter-spacing: 0.2px;
        text-transform: uppercase;
    }

    .subTitle {
        font-weight: 600;
        padding: 0 30px;
        font-size: 20px;
        color: #03548d;
        line-height: 1.2;
        text-align: center;
        margin: 10px;
        max-width: 250px;
        letter-spacing: 0.1px;
        border-radius: 10px;
    }

    .highlight {
        font-weight: 600;
        color: #03548d;
    }

    .freeHighlight {
        color: #ff9800;
        font-weight: 900;
    }

    .stepSlider {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: white;
        box-sizing: border-box;
    }

    .stepContent {
        min-height: 220px;
    }

    .stepNavigation {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-top: 20px;
        margin-bottom: 10px;
    }

    .stepButton {
        padding: 8px 18px;
        border-radius: 18px;
        border: none;
        cursor: pointer;
    }

    .backButton {
        background: #eee;
        color: #fff;
        cursor: not-allowed;
    }

    .backButton:not(:disabled) {
        background: #286fa1;
        cursor: pointer;
    }

    .nextButton {
        background: #0a2c4d;
        color: #fff;
    }

    .stepCounter {
        color: #9a9a9a;
        font-weight: 500;
    }
</style>

<div class="overlay">
    <div class="popup">
        <button onclick="closePopup()" class="closeButton">×</button>
        <img src="@(cdnUri)/banner/BannerPC.png" alt="AdvCash" class="bannerImage" />
        
        <div id="adsContent" class="adsContent">
            <div class="mainTitle">
                EXCLUSIVELY FOR YOU
            </div>
            <div class="subTitle">
                Enjoy Cash Service <span class="pulseAnimate freeHighlight">FREE</span> for 14 days!
            </div>
            <div class="buttonContainer">
                <button class="primaryButton" onclick="showActiveCashContent()">
                    Activate now
                </button>
                <button class="secondaryButton" onclick="showStepSlider()">
                    Find out more
                </button>
            </div>
        </div>

        <div id="activeCashContent" class="activeCashContent" style="display: none;">
            <div class="contentBox">
                <div class="title">
                    Ready to unlock faster cash flow?
                </div>
                <div class="divider"></div>
                <div class="description">
                    <span class="highlight">14-days free trial</span> – save THB 2,800.
                </div>
                <div class="description">
                    No platform fee (THB 200/day).
                    <br />
                    Only THB 0.15 per transaction and promotion.
                    <br />
                    Don't miss this chance to elevate your cash flow. 
                    <br />
                    The sooner you start, the sooner you profit.
                </div>
                <div class="buttonContainer">
                    <button class="primaryButton" onclick="confirmActivation()">
                        Confirm
                    </button>
                    <button class="secondaryButton" onclick="showAdsContent()">
                        Cancel
                    </button>
                </div>
            </div>
        </div>

        <div id="stepSlider" class="stepSlider" style="display: none;">
            <button onclick="showAdsContent()" class="closeButton">×</button>
            <div id="stepContent" class="stepContent">
                <!-- Step content will be dynamically updated -->
            </div>
            <div class="stepNavigation">
                <button id="backButton" class="stepButton backButton" onclick="previousStep()" disabled>Back</button>
                <button id="nextButton" class="stepButton nextButton" onclick="nextStep()">Next</button>
            </div>
            <div class="stepCounter">
                <span id="currentStep">1</span> of <span id="totalSteps">5</span>
            </div>
        </div>
    </div>
</div>

<script>
    let currentStep = 0;
    const totalSteps = 5;
    const steps = [
        {
            description: "Instant deposits and withdrawals!",
            image: "/public/cash-service-ads/step1.png"
        },
        {
            description: "Manage credit and cash member",
            image: "/public/cash-service-ads/step2.png"
        },
        {
            description: "Dedicated domain",
            image: "/public/cash-service-ads/step3.gif"
        },
        {
            description: "Customise promotions",
            image: "/public/cash-service-ads/step4.png"
        },
        {
            description: "Try Cash Service for free!"
        }
    ];

    function showAdsContent() {
        document.getElementById('adsContent').style.display = 'flex';
        document.getElementById('activeCashContent').style.display = 'none';
        document.getElementById('stepSlider').style.display = 'none';
    }

    function showActiveCashContent() {
        document.getElementById('adsContent').style.display = 'none';
        document.getElementById('activeCashContent').style.display = 'flex';
        document.getElementById('stepSlider').style.display = 'none';
    }

    function showStepSlider() {
        document.getElementById('adsContent').style.display = 'none';
        document.getElementById('activeCashContent').style.display = 'none';
        document.getElementById('stepSlider').style.display = 'flex';
        updateStepContent();
    }

    function updateStepContent() {
        const step = steps[currentStep];
        const stepContent = document.getElementById('stepContent');
        stepContent.innerHTML = `
            <div class="description">${step.description}</div>
            ${step.image ? `<img src="${step.image}" class="bannerImage" />` : ''}
        `;

        document.getElementById('currentStep').textContent = currentStep + 1;
        document.getElementById('backButton').disabled = currentStep === 0;
        
        const nextButton = document.getElementById('nextButton');
        if (currentStep === totalSteps - 1) {
            nextButton.textContent = 'Finish';
            nextButton.onclick = confirmActivation;
        } else {
            nextButton.textContent = 'Next';
            nextButton.onclick = nextStep;
        }
    }

    function previousStep() {
        if (currentStep > 0) {
            currentStep--;
            updateStepContent();
        }
    }

    function nextStep() {
        if (currentStep < totalSteps - 1) {
            currentStep++;
            updateStepContent();
        }
    }

    function confirmActivation() {
        // Handle confirmation logic here
        console.log('Activation confirmed');
        closePopup();
    }

    function closePopup() {
        document.querySelector('.overlay').style.display = 'none';
    }
</script>
