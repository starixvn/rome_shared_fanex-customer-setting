{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C#: Fanex.Customer.API Debug",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Services/Fanex.Customer.API/bin/Debug/net8.0/Fanex.Customer.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Services/Fanex.Customer.API",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on: (https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    }
  ]
}